# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL used for Didit callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Didit seller KYC integration.
DIDIT_API_KEY=your-didit-api-key
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret

# Spring Boot backend (admin panel API). Next.js proxies /admin-api/* here.
BACKEND_URL=http://localhost:8080

# Admin login brute-force limits. Defaults shown are the production values.
# Uncomment to loosen ONLY for local testing; do not change in production.
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_LOCKOUT_MINUTES=15
